{
  "name": "clinic-booking-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "accessibility": "npm run build && playwright test tests/e2e/accessibility.spec.ts --project=chromium",
    "e2e": "playwright test",
    "build": "next build",
    "dep-scan": "npm audit --omit=dev --audit-level=high",
    "audit": "npm run dep-scan",
    "sbom": "cyclonedx-npm --output-file sbom.cdx.json",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build && npm run accessibility && npm run dep-scan && npm run sbom",
    "start": "next start",
    "preview": "next start"
  },
  "dependencies": {
    "next": "^16.0.3",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cyclonedx/cyclonedx-npm": "^7.0.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.6",
    "vitest": "4.1.12"
  }
}
