{
  "name": "clinic-booking-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web-patient",
    "apps/web-staff",
    "apps/api",
    "apps/worker-reminders",
    "packages/contracts",
    "packages/domain-scheduling",
    "packages/integrations/scheduling",
    "packages/auth",
    "packages/observability",
    "infra/database"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "npm run typecheck:root && npm run typecheck:workspaces",
    "typecheck:root": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0 && npm run lint:workspaces",
    "lint:workspaces": "npm run lint --workspaces --if-present",
    "format": "prettier --write package.json tsconfig.base.json apps packages infra",
    "format:check": "prettier --check package.json tsconfig.base.json apps packages infra",
    "test": "vitest run && npm run test:workspaces",
    "test:unit": "vitest run && npm run test:workspaces",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:integration": "playwright test",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "build": "npm run typecheck && vite build && npm run build:workspaces",
    "build:frontend": "vite build && npm run build --workspace @clinic/web-patient && npm run build --workspace @clinic/web-staff",
    "build:backend": "npm run build --workspace @clinic/api",
    "build:worker": "npm run build --workspace @clinic/worker-reminders",
    "build:workspaces": "npm run build --workspaces --if-present",
    "accessibility": "playwright test --grep @accessibility --pass-with-no-tests",
    "audit": "npm audit --audit-level=high",
    "security:audit": "npm audit --audit-level=high",
    "sbom": "cyclonedx-npm --output-file sbom.cdx.json",
    "security:sbom": "cyclonedx-npm --output-file sbom.cdx.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^7.0.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "vitest": "^4.1.12"
  }
}
