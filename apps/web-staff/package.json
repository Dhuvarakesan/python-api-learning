{
  "name": "@clinic/web-staff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests --root .",
    "build": "tsc --noEmit -p tsconfig.json && vite build --config vite.config.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
