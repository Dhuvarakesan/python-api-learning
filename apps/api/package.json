{
  "name": "@clinic/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests --root .",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@clinic/contracts": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
